# Copy this file to .env and fill in your own values — .env is gitignored
# and read automatically on startup (see server.js), so you don't have to
# re-export ANTHROPIC_API_KEY in every terminal session.
#
# IMPORTANT — there are two places this file can live, and which one you
# use matters (fixed 2026-09-10, ask: "Fix this so I do not have to edit
# the .env file every time"):
#
#   1. .env right here, next to server.js. Fine for a one-off local
#      override, but this whole app folder gets wholly REPLACED every time
#      you deploy an update (a fresh zip extraction / git pull) — so a
#      .env kept only here is wiped on every single update, and every
#      secret below has to be re-typed from scratch each time.
#   2. ~/.fiu-revenue-estimator.env — same format as this file, but in
#      your home directory instead of the app folder. No update ever
#      touches your home directory, so values here survive every future
#      update automatically. THIS is where you should actually put your
#      real values.
#
# Both are optional and loaded in that order — a variable set in the local
# .env wins if both define it; otherwise the home-directory file fills it
# in. A blank line like `APP_PASSWORD=` (exactly what this template ships,
# below) never counts as "set" either way — it's a placeholder, not a real
# value — so leaving lines in this file blank never blocks the other file
# from supplying a real one. Simplest approach: don't bother with a local
# .env at all — just create ~/.fiu-revenue-estimator.env once (e.g.
# `cp .env.example ~/.fiu-revenue-estimator.env` and edit that copy) and
# never touch it again after updates. The startup log's "Secrets file: ..."
# line confirms whether it was found.

# Required for the chat feature ("Chat with your data") — get one from
# https://platform.claude.com. Leave unset to run the app with chat disabled.
ANTHROPIC_API_KEY=

# Optional — overrides the default chat model (claude-sonnet-5).
# ANTHROPIC_MODEL=

# Optional — port the server listens on (defaults to 3000).
# PORT=

# Required for auto-pulling the monthly counts CSV from a Metabase email
# (see README's "Auto-pull counts from email" section) — leave all three
# unset to keep using the manual "Choose counts file" upload only.

# The Gmail address the daily Metabase email arrives at.
GMAIL_USER=

# A Google "App Password" (16 characters, no spaces) — NOT your regular
# Gmail password. Requires 2-Step Verification to be turned on for the
# account first. Generate one at https://myaccount.google.com/apppasswords.
GMAIL_APP_PASSWORD=

# Text that must appear in the email's subject line for it to be picked up
# as the counts email (case-insensitive substring match) — e.g. the name of
# the Metabase dashboard subscription. Among matching emails from the last
# 14 days, the most recently received one with a CSV attached is used.
METABASE_EMAIL_SUBJECT=

# Optional — how long (in minutes) a successful email check is cached
# before the next page load/field change triggers a fresh IMAP check.
# Defaults to 5. The "Check email now" button always bypasses this.
# EMAIL_CHECK_CACHE_MINUTES=

# Login gate — required before deploying this anywhere public (see
# README's "Login / access control" section). Leave both unset to run
# with no login screen at all, e.g. for local use on your own machine.

# The single shared password the whole team uses to log in.
APP_PASSWORD=

# Signs login sessions. Set this to a long random string (e.g. the output
# of `openssl rand -hex 32`) so logins survive a server restart/redeploy —
# leaving it unset still works, it just logs everyone out on every restart
# (a new random secret is generated each time the process starts).
SESSION_SECRET=

# Optional — where data/*.json (FIU Metadata, Yield & CMGR, Historical
# Actuals, the projection snapshot) is read from/written to. Leave unset
# to use the default: a folder in your home directory
# (~/.fiu-revenue-estimator-data), NOT the data/ folder bundled next to
# this file — that default is deliberate (fixed 2026-09-03) so replacing
# this whole app folder with a freshly delivered copy never overwrites
# your real data. Set this only if you want your data stored somewhere
# else instead, e.g. pointing the app at a separate persistent disk/volume
# such as on Render (see render.yaml). Either way, the app seeds that
# location from the bundled data/ folder automatically the first time it
# boots against an empty one, then leaves it alone from then on.
# DATA_DIR=
